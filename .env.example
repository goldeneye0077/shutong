POSTGRES_DB=network_compliance
POSTGRES_USER=network_compliance
# Change this before any shared or production-like deployment.
POSTGRES_PASSWORD=network_compliance
POSTGRES_PORT=5432

BACKEND_PORT=8000
DATA_SERVICE_PORT=8010
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

BACKEND_APP_NAME=Core Network Compliance Backend
# Change this before any shared or production-like deployment.
BACKEND_SECRET_KEY=change-me
BACKEND_ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_BOOTSTRAP_ADMIN_USERNAME=admin
# Change or disable the bootstrap password after creating a real admin user.
BACKEND_BOOTSTRAP_ADMIN_PASSWORD=admin123

DATA_SERVICE_POLL_INTERVAL=5
DATA_SERVICE_BATCH_SIZE=10
DATA_SERVICE_ENABLE_BACKGROUND_WORKER=false

STORAGE_UPLOADS_PATH=/workspace/storage/uploads
STORAGE_EXPORTS_PATH=/workspace/storage/exports

# Optional override used by `pnpm test:deployment` when services are not on default localhost ports.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
DATA_SERVICE_URL=http://localhost:8010
